# ============================================================
# CashDash - Production Environment Variables
# ============================================================
# Copy this file and fill in real values before deploying.
# NEVER commit real values to git!

# -- App -----------------------------------------------------
NODE_ENV=production
API_PORT=3001

# Your Railway API URL (e.g. https://cashdash-api.up.railway.app)
API_URL=https://YOUR_RAILWAY_URL

# Your Vercel frontend URL (e.g. https://cashdash.vercel.app)
FRONTEND_URL=https://YOUR_VERCEL_URL

# -- Database (Neon.tech) -------------------------------------
# Get from: https://console.neon.tech ? Your Project ? Connection String
# Make sure to add ?sslmode=require at the end
DATABASE_URL=postgresql://USER:PASSWORD@HOST/cashdash?sslmode=require

# -- Security & Auth ------------------------------------------
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=GENERATE_A_STRONG_SECRET_HERE
JWT_REFRESH_SECRET=GENERATE_ANOTHER_STRONG_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=GENERATE_ANOTHER_STRONG_SECRET_HERE

# -- Email (use Resend.com free tier: 3000 emails/month) ------
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=YOUR_RESEND_API_KEY

# -- Admin Bootstrap ------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword!123
ADMIN_USERNAME=admin

# -- Offerwall Secrets ----------------------------------------
TASKWALL_WEBHOOK_SECRET=your-taskwall-postback-password
CPALEAD_WEBHOOK_SECRET=your-cpalead-postback-password
CLICKWALL_WEBHOOK_SECRET=your-clickwall-postback-password
