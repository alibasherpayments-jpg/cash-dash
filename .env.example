# ============================================================
# CashDash Environment Variables
# ============================================================

NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://cashdash:cashdash_dev@localhost:5432/cashdash?schema=public

# Redis (Redis 7)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_ACCESS_SECRET=super_secret_jwt_access_key_1234567890
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_encryption_key_cashdash_2026

# Email / Mailhog
EMAIL_FROM=noreply@cashdash.io
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Mock Provider Secrets (for webhook signatures)
MOCK_PROVIDER_A_SECRET=mock-secret-a-webhook-signature
MOCK_PROVIDER_B_SECRET=mock-secret-b-webhook-signature
MOCK_SURVEY_PROVIDER_SECRET=mock-survey-secret-webhook
MOCK_GAME_PROVIDER_SECRET=mock-game-secret-webhook

# Admin Bootstrap Credentials
ADMIN_EMAIL=admin@cashdash.io
ADMIN_PASSWORD=Admin@CashDash2024!
ADMIN_USERNAME=admin
